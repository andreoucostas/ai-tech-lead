#!/bin/sh
# Opt-in maintainer hook. Scans the staged snapshot, independent of how files reached disk.
repo_root=$(git rev-parse --show-toplevel) || exit 1
pwsh_host=$(command -v pwsh 2>/dev/null || true)
if [ -z "$pwsh_host" ]; then
  for candidate in \
    "/c/Program Files/PowerShell/7/pwsh.exe" \
    /c/Program\ Files/WindowsApps/Microsoft.PowerShell_*_x64__8wekyb3d8bbwe/pwsh.exe
  do
    if [ -x "$candidate" ]; then pwsh_host=$candidate; break; fi
  done
fi
[ -n "$pwsh_host" ] || { echo 'COMMIT REFUSED: PowerShell 7 is unavailable to scan staged content.' >&2; exit 1; }
exec "$pwsh_host" -NoProfile -File "$repo_root/.claude/scripts/check-staged-content.ps1"
