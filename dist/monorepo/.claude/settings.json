{
  "_comment": "Hooks run via PowerShell 7 (pwsh), the primary supported Windows host. The installer falls back to Windows PowerShell 5.1 settings when pwsh is unavailable. Edit AGENTS.md for rules, not this file. Each hook sets cwd \".\" (the repository root) because Copilot CLI and VS Code's Copilot harness also run this file, and could otherwise start a hook in a subfolder workspace, where its relative script path fails.",
  "env": { "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1" },
  "defaultShell": "powershell",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/session-start.ps1", "shell": "powershell", "cwd": "." }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/route-prompt.ps1", "shell": "powershell", "cwd": "." }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/guard.ps1 ; exit $LASTEXITCODE", "shell": "powershell", "cwd": "." }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/post-write.ps1 ; exit $LASTEXITCODE", "shell": "powershell", "timeout": 90, "cwd": "." },
          { "type": "command", "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/audit-trail.ps1", "shell": "powershell", "cwd": "." }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/boy-scout-check.ps1", "shell": "powershell", "cwd": "." }
        ]
      }
    ]
  }
}
