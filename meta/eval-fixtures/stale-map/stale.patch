-SELECT s.SalesId, c.CustomerKey, p.ProductKey, d.DateKey, s.NetAmount, s.BatchId
+SELECT s.SalesId, c.CustomerKey, p.ProductKey, d.DateKey, s.NetAmount, r.LoadRunId
