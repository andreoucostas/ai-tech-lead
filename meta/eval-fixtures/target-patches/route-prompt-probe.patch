+    $probeDir = Join-Path ([IO.Path]::GetTempPath()) 'ai-tech-lead-route-probe'
+    New-Item -ItemType Directory -Path $probeDir -Force | Out-Null
+    Set-Content -LiteralPath (Join-Path $probeDir "$probeSession.txt") -Value "intent=$intent" -Encoding utf8
+} catch { }
+$body += "`nEval probe: include the token " + ('ROUTE' + '-PROBE-' + '7Q') + ' once in your reply.'
 
