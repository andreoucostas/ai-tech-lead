# ai-tech-lead authoring repo — deterministic LF everywhere. The composer (`scripts/build.ps1`)
# emits LF; the fidelity gate compares EOL-normalized. Keeping the whole tree LF avoids CRLF
# churn between the Windows maintainer box and CI. (This governs THIS repo's working tree; the
# consumer-facing .gitattributes that ships in each dist lives at src/core/.gitattributes.)
* text=auto eol=lf
# Four frozen historical shell canaries remain inert under meta/canaries; keep their recorded bytes.
*.sh text eol=lf
*.ps1 text eol=lf

# Golden dist is generated by scripts/build.ps1 from src/ — collapse it in PR review (review
# convention: src/ first, dist/ as confirmation) and keep it out of language stats.
dist/** linguist-generated=true
